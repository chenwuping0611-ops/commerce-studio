# Copy this file to .flaskenv for local development.
# Never commit real credentials, private IPs, or production storage URLs.
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_CONFIG=development

SYSTEM_NAME=Commerce Studio

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pear_ai_studio
MYSQL_TEST_DATABASE=pear_ai_studio_test
MYSQL_USERNAME=your-user
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=20

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me-before-deploy

# Development log settings. The production systemd service uses the
# PEAR_AI_* settings below and always writes under /var/log/pear-ai.
LOG_DIR=logs
APP_LOG_FILE=
LOG_STRICT=false
LOG_TO_CONSOLE=true
ALEMBIC_LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
GUNICORN_LOG_LEVEL=info

# Production logging defaults. Keep these values when running production
# commands manually; deploy/pear-ai.service sets them explicitly as well.
PEAR_AI_LOG_DIR=/var/log/pear-ai
PEAR_AI_APP_LOG_FILE=/var/log/pear-ai/pear-ai.log
PEAR_AI_LOG_LEVEL=INFO
PEAR_AI_LOG_STRICT=true
PEAR_AI_LOG_TO_CONSOLE=false

STUDIO_DEFAULT_PROVIDER_URL=https://toapis.com
STUDIO_REQUEST_TIMEOUT=120
STUDIO_POLL_INTERVAL=10

# Optional Kuaipao Responses provider seed. Never commit a real API key.
KUAIPAO_BASE_URL=https://kuaipao.pro/v1
KUAIPAO_API_KEY=
# The Kuaipao catalog exposes the verified text models:
# gpt-5.4, gpt-5.5, gpt-5.6-sol, and gpt-5.6-terra.
KUAIPAO_TIMEOUT=180

# Optional Interface AI Responses provider seed. Never commit a real API key.
JIEKOU_BASE_URL=https://api.jiekou.ai/openai/v1
JIEKOU_API_KEY=
# The Interface AI catalog exposes:
# gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.6-sol, gpt-5.6-terra,
# and gpt-5.6-luna.
JIEKOU_TIMEOUT=600

GOFASTDFS_INTERNAL_URL=http://127.0.0.1:8080
GOFASTDFS_PUBLIC_URL=https://your-domain.example/gofastdfs
GOFASTDFS_GROUP=group1
GOFASTDFS_TIMEOUT=120
GOFASTDFS_MAX_FILE_SIZE=536870912
GOFASTDFS_VERIFY_SSL=true
GOFASTDFS_UPLOAD_ENDPOINT=/{group}/upload
GOFASTDFS_DELETE_ENDPOINT=/{group}/delete
STUDIO_TEMPORARY_RETENTION_DAYS=30
STUDIO_ASSET_TTL_DAYS=30
ADMIN_LOG_RETENTION_DAYS=90
STUDIO_CLEANUP_BATCH_SIZE=100
STUDIO_POLL_BATCH_SIZE=20
STUDIO_HTTP_POOL_SIZE=10
STUDIO_HTTP_MAX_RETRIES=2
STUDIO_PROVIDER_RETRY_COUNT=3
STUDIO_PROVIDER_RETRY_BACKOFF=0.5
STUDIO_ASSET_CLEANUP_INTERVAL=3600

AMAZON_AI_MAX_TEXT_BYTES=120000
AMAZON_AI_MAX_INPUT_FILES=10
AMAZON_AI_MAX_COMBINED_CONTEXT_BYTES=280000
AMAZON_AI_MAX_OUTPUT_TOKENS=128000
AMAZON_AI_MAX_UPLOAD_FILE_BYTES=536870912
