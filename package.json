{
  "name": "commerce-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI ecommerce product image and video generation workbench",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "build:web": "vite build --config web/vite.config.ts",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"web/src/**/*.{ts,tsx}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/nestjs": "7.0.0",
    "@adminjs/prisma": "5.0.4",
    "@nestjs/common": "10.4.20",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "6.19.2",
    "@xyflow/react": "12.11.2",
    "adminjs": "7.8.17",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "express-session": "1.18.2",
    "express-formidable": "1.2.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.20",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.8.0",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "4.17.23",
    "@types/express-session": "1.18.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.19.2",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vite": "6.3.5"
  }
}
