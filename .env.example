NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=commerce-studio
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=false
FRONTEND_ORIGINS=http://localhost:3000

# MySQL is external. The application does not install or start MySQL.
DATABASE_URL=mysql://commerce:change-me@127.0.0.1:3306/commerce_studio
DATABASE_REQUIRED=false

# Application session/JWT secret. Use a random value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# 32-byte hex key for AES-256-GCM provider API key encryption.
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AdminJS credentials are only a bootstrap/admin-panel login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_PASSWORD=replace-with-another-long-random-secret
ADMINJS_WATCH=false

MEDIA_ROOT=./storage/media
MAX_UPLOAD_BYTES=52428800
GENERATION_WORKER_ENABLED=true
GENERATION_POLL_INTERVAL_MS=5000
GENERATION_MAX_RETRIES=2

# Optional provider defaults. Store real secrets in the server environment only.
MODEL_REQUEST_TIMEOUT_MS=30000
MODEL_DOWNLOAD_TIMEOUT_MS=120000
