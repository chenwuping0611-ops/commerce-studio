NODE_ENV=production
APP_NAME=commerce-studio
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://commerce.example.com
TRUST_PROXY=true
FRONTEND_ORIGINS=https://commerce.example.com

# External MySQL. Do not commit the real password.
DATABASE_URL=mysql://commerce_app:replace-with-password@mysql.internal:3306/commerce_studio
DATABASE_REQUIRED=true

# Generate unique values before deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
APP_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
ADMIN_COOKIE_PASSWORD=replace-with-another-long-random-secret
ADMINJS_WATCH=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-seed

MEDIA_ROOT=/app/storage/media
MAX_UPLOAD_BYTES=52428800
GENERATION_WORKER_ENABLED=true
GENERATION_POLL_INTERVAL_MS=5000
GENERATION_MAX_RETRIES=2
MODEL_REQUEST_TIMEOUT_MS=30000
MODEL_DOWNLOAD_TIMEOUT_MS=120000
MODEL_WINDOWS_HTTP_FALLBACK=true
