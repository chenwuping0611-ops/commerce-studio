generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProviderKind {
  NATIVE
  OPENAI_COMPATIBLE
}

enum GenerationType {
  IMAGE
  VIDEO
}

enum TaskStatus {
  CREATED
  QUEUED
  RUNNING
  PROVIDER_SUBMITTED
  PROVIDER_PROCESSING
  SUCCEEDED
  FAILED
  RETRY_WAITING
  CANCEL_REQUESTED
  CANCELLED
  EXPIRED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  displayName      String
  status           UserStatus       @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userRoles        UserRole[]
  teamMemberships  TeamMember[]
  createdProducts  Product[]        @relation("ProductCreatedBy")
  ownedProducts    Product[]        @relation("ProductOwner")
  createdTasks     GenerationTask[] @relation("TaskCreatedBy")
  canvases         CanvasDocument[] @relation("CanvasCreatedBy")
  auditLogs        AuditLog[]       @relation("AuditActor")
  memoryVersions   ProductMemoryVersion[] @relation("MemoryCreatedBy")
  promptVersions   PromptVersion[]  @relation("PromptCreatedBy")
  createdSkills    SkillProfile[]   @relation("SkillCreatedBy")
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
}

model UserRole {
  userId     String
  roleId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Team {
  id          String         @id @default(cuid())
  name        String
  code        String         @unique
  members     TeamMember[]
  products    Product[]
  canvases    CanvasDocument[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TeamMember {
  userId      String
  teamId      String
  isLead      Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([userId, teamId])
  @@index([teamId])
}

model Product {
  id               String                  @id @default(cuid())
  name             String
  code             String                  @unique
  brand            String?
  category         String?
  description      String?                 @db.Text
  status           ProductStatus           @default(DRAFT)
  createdById      String
  ownerId          String?
  teamId           String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdBy        User                    @relation("ProductCreatedBy", fields: [createdById], references: [id])
  owner            User?                   @relation("ProductOwner", fields: [ownerId], references: [id])
  team             Team?                   @relation(fields: [teamId], references: [id])
  variants         ProductVariant[]
  assets           ProductAsset[]
  facts            ProductFact[]
  brandMemories    BrandMemory[]
  generationRules  GenerationRule[]
  forbiddenRules   ForbiddenRule[]
  memoryVersions   ProductMemoryVersion[]
  promptTemplates  PromptTemplate[]
  promptVersions   PromptVersion[]
  generationTasks  GenerationTask[]
  generationAssets GenerationAsset[]
  canvases         CanvasDocument[]

  @@index([createdById])
  @@index([ownerId])
  @@index([teamId])
  @@index([status])
}

model ProductVariant {
  id          String         @id @default(cuid())
  productId   String
  sku         String
  name        String?
  color       String?
  size        String?
  material    String?
  status      ProductStatus  @default(DRAFT)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  assets      ProductAsset[]
  tasks       GenerationTask[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

model ProductAsset {
  id          String             @id @default(cuid())
  productId   String
  variantId   String?
  type        String
  view        String?
  storageKey  String
  originalName String?
  mimeType    String
  byteSize    Int
  sha256      String
  reviewStatus AssetReviewStatus @default(PENDING)
  createdById String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([sha256])
}

model ProductFact {
  id          String   @id @default(cuid())
  productId   String
  key         String
  value       String   @db.Text
  source      String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
}

model BrandMemory {
  id          String   @id @default(cuid())
  productId   String
  key         String
  value       String   @db.Text
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
}

model GenerationRule {
  id          String   @id @default(cuid())
  productId   String
  rule        String   @db.Text
  priority    Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, priority])
}

model ForbiddenRule {
  id          String   @id @default(cuid())
  productId   String
  rule        String   @db.Text
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model ProductMemoryVersion {
  id          String   @id @default(cuid())
  productId   String
  version     Int
  snapshot    Json
  createdById String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("MemoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([productId, version])
  @@index([productId, createdAt])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  productId   String?
  name        String
  template    String   @db.Text
  createdById String
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  versions    PromptVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

model PromptVersion {
  id          String          @id @default(cuid())
  productId   String?
  templateId  String?
  version     Int
  promptText  String          @db.Text
  systemText  String?         @db.Text
  metadata    Json?
  createdById String
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  template    PromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("PromptCreatedBy", fields: [createdById], references: [id])
  executions  PromptExecution[]
  createdAt   DateTime        @default(now())

  @@index([productId, createdAt])
}

model PromptExecution {
  id             String        @id @default(cuid())
  promptVersionId String
  taskId         String?
  input          Json
  output         Json
  promptVersion  PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  task           GenerationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([promptVersionId])
  @@index([taskId])
}

model ModelProvider {
  id             String       @id @default(cuid())
  name           String       @unique
  kind           ProviderKind
  baseUrl        String
  modelsPath     String?
  balancePath    String?
  apiKeyEncrypted String       @db.Text
  apiKeyHint     String?
  enabled        Boolean      @default(true)
  profiles       ModelProfile[]
  tasks          GenerationTask[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ModelProfile {
  id           String        @id @default(cuid())
  providerId   String
  name         String
  capability   Json
  endpointPath String?
  enabled      Boolean       @default(true)
  provider     ModelProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tasks        GenerationTask[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([providerId, name])
  @@index([providerId])
}

model SkillProfile {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  mediaType      String
  description    String?  @db.Text
  version        String?
  tags           Json?
  promptTemplate String?  @db.Text
  negativePrompt String?  @db.Text
  settings       Json?
  enabled        Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("SkillCreatedBy", fields: [createdById], references: [id])

  @@index([mediaType, enabled])
  @@index([createdById, createdAt])
}

model GenerationTask {
  id             String             @id @default(cuid())
  historyCode    String?            @unique
  productId      String
  variantId      String?
  createdById    String
  providerId     String
  modelProfileId String
  type           GenerationType
  status         TaskStatus         @default(CREATED)
  idea           String             @db.Text
  promptSnapshot Json
  memorySnapshot Json
  inputAssets    Json?
  output         Json?
  providerTaskId String?
  retryCount     Int                @default(0)
  maxRetries     Int                @default(2)
  leaseUntil     DateTime?
  heartbeatAt    DateTime?
  nextPollAt     DateTime?
  errorCode      String?
  errorSummary   String?            @db.Text
  idempotencyKey String?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  product        Product            @relation(fields: [productId], references: [id])
  variant        ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdBy      User               @relation("TaskCreatedBy", fields: [createdById], references: [id])
  provider       ModelProvider      @relation(fields: [providerId], references: [id])
  modelProfile   ModelProfile       @relation(fields: [modelProfileId], references: [id])
  attempts       GenerationAttempt[]
  assets         GenerationAsset[]
  costLedger     CostLedger?
  promptExecutions PromptExecution[]

  @@index([status, nextPollAt])
  @@index([createdById, createdAt])
  @@index([productId, createdAt])
  @@unique([createdById, idempotencyKey])
}

model GenerationAttempt {
  id             String         @id @default(cuid())
  taskId         String
  attempt        Int
  providerTaskId String?
  request        Json?
  response       Json?
  status         TaskStatus
  errorCode      String?
  errorSummary   String?        @db.Text
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  task           GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, attempt])
  @@index([taskId])
}

model GenerationAsset {
  id          String         @id @default(cuid())
  taskId      String
  productId   String
  storageKey  String
  originalName String?
  mimeType    String
  byteSize    Int
  sha256      String
  sourceUrl   String?
  task        GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  createdAt   DateTime       @default(now())

  @@index([taskId])
  @@index([productId])
  @@index([sha256])
}

model CostLedger {
  id             String         @id @default(cuid())
  taskId         String         @unique
  providerId     String
  modelProfileId String
  currency       String         @default("USD")
  amount         Decimal        @db.Decimal(12, 6)
  usage          Json?
  task           GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([providerId, createdAt])
}

model CanvasDocument {
  id          String           @id @default(cuid())
  name        String
  productId   String?
  teamId      String?
  createdById String
  version     Int              @default(1)
  nodes       Json
  edges       Json
  viewport    Json
  settings    Json?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CanvasCreatedBy", fields: [createdById], references: [id])
  revisions   CanvasRevision[]
  executions  CanvasExecution[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
  @@index([teamId])
  @@index([productId])
}

model CanvasRevision {
  id          String         @id @default(cuid())
  canvasId    String
  version     Int
  nodes       Json
  edges       Json
  viewport    Json
  summary     String?
  createdById String
  canvas      CanvasDocument @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([canvasId, version])
  @@index([canvasId])
}

model CanvasExecution {
  id          String         @id @default(cuid())
  canvasId    String
  version     Int
  snapshot    Json
  taskIds     Json?
  status      TaskStatus      @default(CREATED)
  canvas      CanvasDocument  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@index([canvasId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  metadata   Json?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resource, resourceId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
